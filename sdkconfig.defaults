# This file was generated using idf.py save-defconfig. It can be edited manually.
# Espressif IoT Development Framework (ESP-IDF) Project Minimal Configuration
#
CONFIG_IDF_TARGET="esp32s31"
CONFIG_BSP_SELECT_ESP32_S31_KORVO_1=y

CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_FREERTOS_HZ=1000
## ★ 中断栈（ISR stack）1536 → 4096（2026-09-22 修 `Stack protection fault`）
##   症状：连上蓝牙后切到 SINK 页，taskLVGL 触发 HW 栈保护 panic：
##     Detected in task "taskLVGL" / MEPC → _interrupt_handler(vectors.S)
##     Stack bounds: 0x2f02a100 - 0x2f02a700   ← 差 0x600 = 1536
##   判据：portasm.S:698-713 在**每次进中断时**把 HW 栈守卫的窗口设成
##     (xIsrStackBottom, xIsrStackTop)，而 riscv/portmacro.h:95 `portSTACK_TYPE = uint8_t`
##     ⇒ xIsrStack 的字节数 == CONFIG_FREERTOS_ISR_STACKSIZE。0x600 == 1536 == 本项，
##     即溢出的是**中断栈**，不是任何任务栈（任务栈不会正好 1536）。
##   机制：avoid_tearing + DIRECT 模式每帧 = 1 次 vsync ISR + 480/HEIGHT 次 bounce ISR；
##     SINK 页改版后 EQ 动画让它持续 ~30fps 重绘，display ISR 与刚连上蓝牙的
##     HCI/AVDTP ISR 在同一核上**嵌套**，每层压 ~140B，1536B 被打穿。
##   代价：每核各一份 ⇒ 2×(4096-1536) = +5KB 内部 RAM（bounce 省下的 31.25KB 足够覆盖）。
##   IDF 该项默认就是 1536（Kconfig range 1536~32768），本项目此前用的是默认最小值。
CONFIG_FREERTOS_ISR_STACKSIZE=4096
CONFIG_BSP_LCD_RGB_BUFFER_NUMS=2
## ★ §79g（v2.0）刷新模式定稿 = AUTO（GDMA 直接扫 PSRAM 整帧环形链）。
##   历史：bb 模式（bounce 10 行）EOF 中断里从 PSRAM 搬 16KB/次，flash 写冻结
##   cache → ISR 卡死 → 搬运/消费指针错开 → 屏幕内容下移定格且不自愈
##   （连 WiFi / 连上位机时刻必现）。2026-09-25 花屏修复曾改 AUTO=y，但改动
##   只落在本地 sdkconfig、从未进 git，被 fullclean 冲掉 —— 漂移事故重演。
##   本次三处固化：defaults + sdkconfig + sdkconfig.bsp.esp32_s31_korvo_1。
##   收益：消掉 ~2900 次/s EOF ISR + memcpy CPU 负载，省 32KB 内部 DMA bounce；
##   偏移退化为瞬态撕裂线（冻结期 GDMA 停等、恢复后行序天然对齐）。
CONFIG_BSP_LCD_RGB_REFRESH_AUTO=y
CONFIG_BSP_DISPLAY_LVGL_AVOID_TEAR=y
CONFIG_BSP_DISPLAY_LVGL_DIRECT_MODE=y
#CONFIG_LV_ATTRIBUTE_FAST_MEM_USE_IRAM=y
CONFIG_CODEC_I2C_BACKWARD_COMPATIBLE=n

## LVGL9 ##
CONFIG_LV_CONF_SKIP=y
CONFIG_LV_BUILD_EXAMPLES=n

## ★ 2026-09-22：LVGL 的 LV_FONT_MONTSERRAT_* 在 Kconfig 里**没有** default y，
##   只能在 menuconfig 里手工勾。此前 CONFIG_LV_FONT_MONTSERRAT_28 只存在于生成的
##   `sdkconfig` 里、defaults 里没有 ⇒ 一旦删 sdkconfig 重新 configure 就会掉成 n，
##   `lv_font_montserrat_28` 变成未定义符号，链接期才炸。
##   SINK 页的圆形上一首/播放/下一首图标（LV_SYMBOL_*）用 28px，所以必须钉住。
CONFIG_LV_FONT_MONTSERRAT_28=y

## ★ 2026-09-24：PC 副屏改版把三个媒体键从 48px 挪到**右手侧竖排 80px**，
##   图标相应放大到 40px（80px 圆键 + 28px 图标太小）。同样必须在 defaults 里钉住，
##   否则删掉 sdkconfig 重配就掉成 n ⇒ lv_font_montserrat_40 未定义，链接期才炸。
CONFIG_LV_FONT_MONTSERRAT_40=y

#CLIB default
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_USE_CLIB_STRING=y

# Performance monitor
CONFIG_LV_USE_OBSERVER=y
CONFIG_LV_USE_SYSMON=y
CONFIG_LV_USE_PERF_MONITOR=y

## LVGL8 - uncomment, when using LVGL8 ##
# CONFIG_LV_USE_PERF_MONITOR=y
# CONFIG_LV_COLOR_16_SWAP=y
# CONFIG_LV_MEM_CUSTOM=y
# CONFIG_LV_MEMCPY_MEMSET_STD=y
# CONFIG_LV_SPRINTF_CUSTOM=y

CONFIG_LV_USE_FLOAT=y
CONFIG_LV_USE_GESTURE_RECOGNITION=y

## ★ btsink（A2DP Sink）Phase 5：中文 bin 字体从 PSRAM 加载 ##
## `lv_binfont_create_from_buffer()` 依赖 memfs（LV_USE_FS_MEMFS），
## 它把内存里的字体文件当"伪文件"喂给 lv_fs，**不是** FS_POSIX。
## LETTER=65（'A'）为 memfs 盘符，其余 FS 驱动均为 0，不冲突。
CONFIG_LV_USE_FS_MEMFS=y
CONFIG_LV_FS_MEMFS_LETTER=65

## PPA (Pixel Processing Accelerator) on ESP32-S31 ##
## 注：LVGL 9.5 内置 lv_draw_ppa 仅支持 ESP32-P4（依赖 CONFIG_CACHE_L2_CACHE_LINE_SIZE，S31 无此 Kconfig）
## 待 LVGL 后续版本适配 S31 后再开启。当前先留空，软件渲染。
# CONFIG_LV_USE_PPA is not set
# CONFIG_LV_USE_PPA_IMG is not set

## Bluetooth Classic (BR/EDR) — A2DP Source/Sink + AVRCP 控制 ##
## 参考官方例程 sdkconfig.defaults.esp32s31.classic；仅开 A2DP/AVRCP，不开 HFP/BLE，省内存 ##
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_CONTROLLER_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=y
CONFIG_BTDM_CTRL_BR_EDR_MAX_SYNC_CONN=1
CONFIG_BT_A2DP_ENABLE=y
CONFIG_BT_A2DP_USE_EXTERNAL_CODEC=y
CONFIG_BT_AVRCP_ENABLED=y
## Cover Art（AVRCP 1.6 BIP/OBEX 封面传输）：缺失会导致 clean build 后封面永远收不到。
## 注意：本项**只**让控制端具备发起/接收能力；对端（手机播放器）必须在 SDP 里声明
## TG_COVER_ART，本端才会去连 BIP 通道，否则日志里不会出现 cover art 相关行。
CONFIG_BT_AVRCP_CT_COVER_ART_ENABLED=y
# CONFIG_BT_HFP_ENABLE is not set
# CONFIG_BT_BLE_ENABLED is not set
# CONFIG_BT_NIMBLE_ENABLED is not set
CONFIG_ESP_BT_AUDIO_GMF_IO_SUPPORT=y
## bluedroid 协议栈内存优先放 PSRAM，避免开机后开蓝牙时内部 RAM 不足导致 HCI mempool init 失败 ##
CONFIG_BT_ALLOCATION_FROM_SPIRAM_FIRST=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=0
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

## bluedroid 自带代码在 -Werror 下报 strncpy truncation，关闭默认警告视为错误 ##
CONFIG_COMPILER_DISABLE_DEFAULT_ERRORS=y

## ---- WiFi 局域网 OTA（方案 docs/项目规划/WiFi局域网OTA升级实施方案.md §3.4）----
## ★ 必须写进 defaults：只改 sdkconfig 的话 reconfigure 会掉回 n，且要到链接期才炸。
## 开 ROLLBACK 后 bootloader 多一份 PENDING_VERIFY 逻辑：新固件不自证则下次启动回滚。
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
## 注：本方案用 esp_http_client + esp_ota_* 手动实现（非 esp_https_ota 组件），
## 故无需 CONFIG_ESP_HTTPS_OTA_ALLOW_HTTP —— http:// 明文由 esp_http_client 直接支持。
