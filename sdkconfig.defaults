# This file was generated using idf.py save-defconfig. It can be edited manually.
# Espressif IoT Development Framework (ESP-IDF) Project Minimal Configuration
#
CONFIG_IDF_TARGET="esp32s31"
CONFIG_BSP_SELECT_ESP32_S31_KORVO_1=y

CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_FREERTOS_HZ=1000
CONFIG_BSP_LCD_RGB_BUFFER_NUMS=2
CONFIG_BSP_LCD_RGB_BOUNCE_BUFFER_MODE=y
CONFIG_BSP_LCD_RGB_BOUNCE_BUFFER_HEIGHT=20
CONFIG_BSP_DISPLAY_LVGL_AVOID_TEAR=y
CONFIG_BSP_DISPLAY_LVGL_DIRECT_MODE=y
#CONFIG_LV_ATTRIBUTE_FAST_MEM_USE_IRAM=y
CONFIG_CODEC_I2C_BACKWARD_COMPATIBLE=n

## LVGL9 ##
CONFIG_LV_CONF_SKIP=y
CONFIG_LV_BUILD_EXAMPLES=n

#CLIB default
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_USE_CLIB_STRING=y

# Performance monitor
CONFIG_LV_USE_OBSERVER=y
CONFIG_LV_USE_SYSMON=y
CONFIG_LV_USE_PERF_MONITOR=y

## LVGL8 - uncomment, when using LVGL8 ##
# CONFIG_LV_USE_PERF_MONITOR=y
# CONFIG_LV_COLOR_16_SWAP=y
# CONFIG_LV_MEM_CUSTOM=y
# CONFIG_LV_MEMCPY_MEMSET_STD=y
# CONFIG_LV_SPRINTF_CUSTOM=y

CONFIG_LV_USE_FLOAT=y
CONFIG_LV_USE_GESTURE_RECOGNITION=y

## PPA (Pixel Processing Accelerator) on ESP32-S31 ##
## 娉細LVGL 9.5 鍐呯疆 lv_draw_ppa 浠呮敮鎸?ESP32-P4锛堜緷璧?CONFIG_CACHE_L2_CACHE_LINE_SIZE锛孲31 鏃犳 Kconfig锛?## 寰?LVGL 鍚庣画鐗堟湰閫傞厤 S31 鍚庡啀寮€鍚€傚綋鍓嶅厛鐣欑┖锛岃蒋浠舵覆鏌撱€?# CONFIG_LV_USE_PPA is not set
# CONFIG_LV_USE_PPA_IMG is not set

CONFIG_LV_USE_FS_POSIX=y
CONFIG_LV_FS_POSIX_LETTER=76
CONFIG_LV_FS_POSIX_PATH_MAX=256
CONFIG_LV_USE_PNG=y
CONFIG_LV_USE_LODEPNG=y
CONFIG_CAMERA_OV3660=y


## Face detect model in LittleFS ##
CONFIG_HUMAN_FACE_DETECT_MODEL_IN_SDCARD=y
CONFIG_HUMAN_FACE_DETECT_MODEL_IN_FLASH_RODATA=n
CONFIG_DEFAULT_HUMAN_FACE_DETECT_MODEL=1
CONFIG_ESPDET_PICO_224_224_FACE=y
CONFIG_HUMAN_FACE_DETECT_MSRMNP_S8_V1=n
CONFIG_ESPDET_PICO_416_416_FACE=n
CONFIG_HUMAN_FACE_DETECT_MODEL_SDCARD_DIR="models"
CONFIG_BSP_SD_MOUNT_POINT="/littlefs"


## OV3660 format: 240x240 RGB565 BE (for esp-dl 224x224 input) ##
CONFIG_CAMERA_OV3660_DVP_RGB565_BE_240X240_24FPS=y
CONFIG_CAMERA_OV3660_DVP_DEFAULT_FMT_RGB565_BE_240X240_24FPS=y
CONFIG_CAMERA_OV3660_DVP_YUV422_YUYV_640X480_10FPS=n
